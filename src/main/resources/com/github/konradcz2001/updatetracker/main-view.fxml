<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.github.konradcz2001.updatetracker.MainController"
           prefHeight="650.0" prefWidth="1100.0"
           stylesheets="@style.css">

    <BorderPane fx:id="dashboardView">
        <top>
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="header-box">
                <Label text="%app.title" styleClass="app-title"/>
                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnThemeToggle" onAction="#onToggleThemeClick" styleClass="icon-button">
                    <graphic>
                        <FontIcon fx:id="themeIcon" iconLiteral="mdal-brightness_3" iconSize="20"/>
                    </graphic>
                    <tooltip><Tooltip text="Toggle Dark Mode"/></tooltip>
                </Button>

                <Separator orientation="VERTICAL" />

                <HBox fx:id="languageContainer" spacing="8" alignment="CENTER">
                    <Button text="PL" userData="pl" onAction="#onLanguagePlClick" focusTraversable="false" styleClass="button, lang-button"/>
                    <Button text="EN" userData="en" onAction="#onLanguageEnClick" focusTraversable="false" styleClass="button, lang-button"/>
                </HBox>
            </HBox>
        </top>

        <center>
            <TableView fx:id="programTable">
                <columns>
                    <TableColumn fx:id="colName" text="%col.name" prefWidth="300"/>
                    <TableColumn fx:id="colLastVersion" text="%col.my_version" prefWidth="150" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colDateOld" text="%col.old_date" prefWidth="120" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colCurrentVersion" text="%col.online_version" prefWidth="150" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colDateNew" text="%col.new_date" prefWidth="120" style="-fx-alignment: CENTER;"/>
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </center>

        <bottom>
            <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="footer-box">
                <Button text="?" onAction="#onAboutClick" style="-fx-min-width: 35px;"/>
                <Region HBox.hgrow="ALWAYS"/>

                <Button text="%btn.add" onAction="#onAddProgramClick"/>
                <Button fx:id="btnEditName" text="%btn.edit" onAction="#onEditNameClick"/>
                <Button fx:id="btnDelete" text="%btn.delete" onAction="#onDeleteProgramClick"/>
                <Button fx:id="btnConfigure" text="%btn.configure" onAction="#onEditSourceClick"/>
                <Button fx:id="btnDownload" text="%btn.update" onAction="#onDownloadUpdateClick"/>

                <Button text="%btn.scan" onAction="#onScanUpdatesClick" styleClass="button-primary"/>
            </HBox>
        </bottom>
    </BorderPane>

    <BorderPane fx:id="editorView" visible="false" styleClass="view-background">
        <top>
            <VBox spacing="0">
                <HBox spacing="15" alignment="CENTER_LEFT" styleClass="editor-header">
                    <Label text="%lbl.configuring" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                    <Label fx:id="editorProgramNameLabel" text="Program Name" style="-fx-font-size: 16px; -fx-text-fill: -color-accent;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="%btn.back" onAction="#onBackToDashboard"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="editor-toolbar">
                    <Button text="←" onAction="#onBrowserBack" style="-fx-min-width: 35px;"/>
                    <Button text="→" onAction="#onBrowserForward" style="-fx-min-width: 35px;"/>
                    <Button text="↻" onAction="#onBrowserReload" style="-fx-min-width: 35px;"/>
                    <TextField fx:id="urlField" promptText="Enter download page URL..." HBox.hgrow="ALWAYS" style="-fx-padding: 8;"/>
                    <Button text="%btn.go" onAction="#onGoClick" defaultButton="true"/>
                </HBox>
            </VBox>
        </top>

        <center>
            <WebView fx:id="webView"/>
        </center>

        <bottom>
            <HBox spacing="15" alignment="CENTER_RIGHT" styleClass="footer-box">
                <Label fx:id="instructionLabel" text="%lbl.navigate" styleClass="instruction-label"/>
                <Button text="%btn.select_version" fx:id="selectElementBtn" onAction="#onSelectElementClick"/>
                <Button text="%btn.select_download" fx:id="selectDownloadBtn" onAction="#onSelectDownloadClick"/>
            </HBox>
        </bottom>
    </BorderPane>
</StackPane>