<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.github.konradcz2001.updatetracker.MainController"
           prefHeight="600.0" prefWidth="900.0">

    <BorderPane fx:id="dashboardView">
        <top>
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: #f4f4f4;">
                <Label text="%app.title" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="5" alignment="CENTER">
                    <Button text="PL" onAction="#onLanguagePlClick" focusTraversable="false"/>
                    <Button text="EN" onAction="#onLanguageEnClick" focusTraversable="false"/>
                </HBox>
                <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
            </HBox>
        </top>

        <center>
            <TableView fx:id="programTable">
                <columns>
                    <TableColumn fx:id="colName" text="%col.name" prefWidth="200"/>
                    <TableColumn fx:id="colLastVersion" text="%col.my_version" prefWidth="120"/>
                    <TableColumn fx:id="colDateOld" text="%col.old_date" prefWidth="100"/>
                    <TableColumn fx:id="colCurrentVersion" text="%col.online_version" prefWidth="120"/>
                    <TableColumn fx:id="colDateNew" text="%col.new_date" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </center>

        <bottom>
            <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10;">
                <Button text="?" onAction="#onAboutClick" style="-fx-min-width: 30px;"/>
                <Button text="%btn.add" onAction="#onAddProgramClick"/>
                <Button fx:id="btnEditName" text="%btn.edit" onAction="#onEditNameClick"/>
                <Button fx:id="btnDelete" text="%btn.delete" onAction="#onDeleteProgramClick"/>
                <Button fx:id="btnConfigure" text="%btn.configure" onAction="#onEditSourceClick"/>
                <Button fx:id="btnDownload" text="%btn.download" onAction="#onDownloadUpdateClick"/>
                <Button text="%btn.scan" onAction="#onScanUpdatesClick" style="-fx-font-weight: bold;"/>
            </HBox>
        </bottom>
    </BorderPane>

    <BorderPane fx:id="editorView" visible="false" style="-fx-background-color: white;">
        <top>
            <VBox spacing="5" style="-fx-padding: 10; -fx-background-color: #e0e0e0; -fx-border-color: #ccc; -fx-border-width: 0 0 1 0;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="%lbl.configuring" style="-fx-font-weight: bold;"/>
                    <Label fx:id="editorProgramNameLabel" text="Program Name"/>
                    <HBox HBox.hgrow="ALWAYS"/> <Button text="%btn.cancel" onAction="#onBackToDashboard"/>
                </HBox>

                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Button text="←" onAction="#onBrowserBack" style="-fx-min-width: 30px;"/>
                    <Button text="→" onAction="#onBrowserForward" style="-fx-min-width: 30px;"/>
                    <Button text="↻" onAction="#onBrowserReload" style="-fx-min-width: 30px;"/>
                    <TextField fx:id="urlField" promptText="Enter download page URL..." HBox.hgrow="ALWAYS"/>
                    <Button text="%btn.go" onAction="#onGoClick" defaultButton="true"/>
                </HBox>
            </VBox>
        </top>

        <center>
            <WebView fx:id="webView"/>
        </center>

        <bottom>
            <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10; -fx-background-color: #f0f0f0;">
                <Label fx:id="instructionLabel" text="%lbl.navigate" textFill="#666666"/>
                <Button text="%btn.select_version" fx:id="selectElementBtn" onAction="#onSelectElementClick"/>
                <Button text="%btn.select_download" fx:id="selectDownloadBtn" onAction="#onSelectDownloadClick"/>
            </HBox>
        </bottom>
    </BorderPane>
</StackPane>